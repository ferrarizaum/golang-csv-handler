# This is an example Terraform variables file.
# Copy this to terraform.tfvars and fill in your values.
# terraform.tfvars is automatically loaded by Terraform.

# AWS region where you want to deploy
aws_region = "us-east-1"

# Environment name
environment = "dev"

# S3 bucket name (MUST be globally unique - add random numbers/letters)
# Example: "my-csv-files-bucket-12345"
s3_bucket_name = "your-unique-bucket-name-here"

# Lambda function name
lambda_function_name = "s3-file-checker"

# Schedule expression - when should Lambda run?
# Options:
#   - "rate(5 minutes)"  - Every 5 minutes
#   - "rate(1 hour)"    - Every hour
#   - "rate(1 day)"     - Every day
#   - "cron(0 9 * * ? *)" - Every day at 9:00 AM UTC
#   - "cron(0 */6 * * ? *)" - Every 6 hours
schedule_expression = "rate(1 hour)"

